---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '~/styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import AskAI from '~/components/AskAI.astro';
import { site } from '~/lib/site';
import defaultShare from '~/assets/site/hero-macro.webp';

interface Props {
  /** Page name; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Image for link previews (iMessage, Instagram, email…). */
  shareImage?: ImageMetadata;
  shareAlt?: string;
  /** Header over a dark first section. */
  darkTop?: boolean;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description = site.description, shareImage = defaultShare, shareAlt, darkTop = false, jsonLd, noindex = false } =
  Astro.props;
const fullTitle = title ? `${title} — ${site.titleSuffix}` : `${site.titleSuffix} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = await getImage({ src: shareImage, width: 1200, format: 'jpeg', quality: 80 });
const ogUrl = new URL(og.src, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.titleSuffix} />
    <meta property="og:title" content={title ?? site.titleSuffix} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? '')} />
    {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#edeae3" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />


    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header dark={darkTop} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <AskAI />
    <script>
      import '~/scripts/reveal';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--plaster);
    font: 500 0.8rem var(--font-mono);
    transition: top 0.2s;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
