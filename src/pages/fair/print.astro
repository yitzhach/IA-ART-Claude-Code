---
/**
 * Printable booth card with a QR code to /fair/. Print it from the browser (letter or A4);
 * not linked from the site and hidden from search engines.
 */
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/500.css';
import QRCode from 'qrcode';
import { site } from '~/lib/site';

const target = new URL('/fair/', site.url).href;
const svg = await QRCode.toString(target, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#1b1917', light: '#00000000' },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Booth card — Isaac Anderson Art</title>
  </head>
  <body>
    <main class="card">
      <p class="eyebrow">Sculptural studio — cement · plaster · steel</p>
      <h1>Isaac Anderson</h1>
      <p class="motto">{site.motto}</p>
      <div class="qr" set:html={svg} />
      <p class="cta">Scan to see available works, prices &amp; commissions</p>
      <p class="url">isaacandersonart.com/fair</p>
      <p class="contact">{site.phone.display} · {site.instagram.handle}</p>
    </main>
    <p class="hint">Print this page (⌘/Ctrl + P). It fits one sheet of letter or A4.</p>
  </body>
</html>

<style>
  @page {
    margin: 0.5in;
  }
  body {
    margin: 0;
    background: #edeae3;
    color: #1b1917;
    font-family: 'Archivo Variable', system-ui, sans-serif;
    display: grid;
    place-items: center;
    min-height: 100vh;
  }
  .card {
    width: min(6.5in, 92vw);
    padding: 0.6in 0.5in;
    background: #f5f3ee;
    border: 1px solid #d6cfc2;
    text-align: center;
    display: grid;
    gap: 0.18in;
    justify-items: center;
  }
  .eyebrow,
  .url,
  .contact {
    font: 500 11px/1.4 'IBM Plex Mono', monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .eyebrow {
    color: #a34a24;
  }
  h1 {
    margin: 0;
    font: 700 46px/1 'Bodoni Moda Variable', serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .motto {
    margin: 0;
    font: italic 300 20px 'Newsreader Variable', serif;
    color: #4a443c;
  }
  .qr {
    width: 3in;
    max-width: 70vw;
    margin: 0.1in 0;
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cta {
    margin: 0;
    font: 500 18px/1.3 'Archivo Variable', sans-serif;
  }
  .url {
    margin: 0;
    font-size: 14px;
    color: #a34a24;
  }
  .contact {
    margin: 0;
    color: #5c564c;
  }
  .hint {
    font: 400 13px 'Archivo Variable', sans-serif;
    color: #5c564c;
  }
  @media print {
    body {
      background: #fff;
      min-height: 0;
    }
    .card {
      border: 0;
      background: #fff;
    }
    .hint {
      display: none;
    }
  }
</style>
