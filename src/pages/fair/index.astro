---
/**
 * Landing page for people who met Isaac at an art fair or show — the booth QR code points here.
 * Thumb-friendly: available works first, save favourites, reach the studio in one tap.
 */
import Base from '~/layouts/Base.astro';
import ArtImage from '~/components/ArtImage.astro';
import WorkGrid from '~/components/WorkGrid.astro';
import InquiryForm from '~/components/InquiryForm.astro';
import { site } from '~/lib/site';
import { getWorks } from '~/lib/works';
import { getShows } from '~/lib/shows';
import ShowList from '~/components/ShowList.astro';
import booth from '~/assets/site/show-booth.webp';
import showWalls from '~/assets/site/show-hero-2.webp';
import showPanels from '~/assets/site/shows-1-full.webp';

const works = await getWorks();
const available = works.filter((w) => w.data.status === 'available');
const sms = site.phone.href.replace('tel:', 'sms:');
const { upcoming } = await getShows();
---

<Base
  title="Good to meet you"
  description="Met Isaac Anderson at a show? See available works, save your favourites, and reach the studio in one tap."
  shareImage={booth}
>
  <section class="wrap hello">
    <p class="eyebrow">At the show</p>
    <h1 class="title">Good to meet you.</h1>
    <p class="lede">
      Everything from the booth, in your pocket — what’s available, what it costs, and how to bring a piece home or
      commission one for your space.
    </p>
    <ul class="quick" role="list">
      <li><a class="btn btn--primary" href="#available">See what’s available</a></li>
      <li><a class="btn btn--ghost" href={sms}>Text the studio</a></li>
      <li><a class="btn btn--ghost" href={site.phone.href}>Call {site.phone.display}</a></li>
      <li><a class="btn btn--ghost" href={site.instagram.href} rel="noopener">Follow {site.instagram.handle}</a></li>
    </ul>
  </section>

  <div class="wrap shows" aria-label="Photos from recent shows">
    <figure class="show-main">
      <ArtImage src={booth} alt="Isaac Anderson's booth at an outdoor art show, panels hung on white walls" sizes="(min-width: 900px) 60vw, 100vw" priority />
    </figure>
    <figure>
      <ArtImage src={showWalls} alt="Visitors walking past white show walls hung with large textured panels" sizes="(min-width: 900px) 30vw, 50vw" />
    </figure>
    <figure>
      <ArtImage src={showPanels} alt="Freestanding show panels holding several works, with a brick building behind" sizes="(min-width: 900px) 30vw, 50vw" />
    </figure>
  </div>

  <section class="section wrap" id="available" aria-labelledby="avail-h">
    <header class="head">
      <div>
        <p class="eyebrow">Available now</p>
        <h2 class="title" id="avail-h">{available.length > 0 ? `${available.length} works ready to go home` : 'New work is coming'}</h2>
      </div>
      <p class="tip">
        Tip: tap a piece, then <strong>Add to inquiry list</strong> — send your favourites together when you’re home, or
        use <strong>View on your wall</strong> to see one at true size.
      </p>
    </header>
    {available.length > 0 && <WorkGrid works={available} />}
    <div class="more">
      <a class="link" href="/works/">The full catalogue →</a>
      <a class="link" href="/commissions/">How commissions work →</a>
    </div>
  </section>

  {
    upcoming.length > 0 && (
      <div class="wrap section--tight upcoming">
        <ShowList shows={upcoming} heading="Where to find Isaac next" eyebrow="Upcoming shows" />
      </div>
    )
  }

  <section class="wrap section--tight">
    <InquiryForm
      source="Art fair page"
      heading="Keep in touch"
      intro="Leave your details and what caught your eye — the studio will follow up within two working days. Designers and trade welcome."
    />
  </section>
</Base>

<style>
  .hello {
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .hello .title {
    font-size: var(--step-4);
    line-height: 1;
  }
  .quick {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .shows {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.75rem;
  }
  .show-main {
    grid-row: span 2;
  }
  .shows :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show-main :global(img) {
    aspect-ratio: 4 / 3;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
    margin-bottom: 2.5rem;
  }
  .head .title {
    margin-top: 0.5rem;
  }
  .tip {
    max-width: 26rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 3rem;
  }
  .section--tight {
    padding-bottom: var(--section);
  }
  @media (max-width: 559px) {
    .quick li {
      flex: 1 1 100%;
    }
    .quick .btn {
      width: 100%;
    }
    .shows {
      grid-template-columns: 1fr 1fr;
    }
    .show-main {
      grid-column: span 2;
      grid-row: auto;
    }
    .shows figure:not(.show-main) :global(img) {
      aspect-ratio: 1;
    }
  }
</style>
