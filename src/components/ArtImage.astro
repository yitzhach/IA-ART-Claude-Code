---
/**
 * Responsive image: Astro resizes the original at build time into several widths,
 * so phones download a small file and retina screens a sharp one.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** How wide the image renders, e.g. "(min-width: 900px) 33vw, 100vw". */
  sizes: string;
  /** true for the main image above the fold (loads first). */
  priority?: boolean;
  class?: string;
  /** Work slug: lets the image glide between pages (see src/pages/transitions.css.ts). */
  transition?: string;
}

const { src, alt, sizes, priority = false, class: className, transition } = Astro.props;
const widths = [240, 320, 480, 640, 800, 960, 1280, 1600, 2000, 2400].filter((w) => w <= src.width);
if (!widths.length || widths[widths.length - 1] < src.width) widths.push(src.width);
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
  data-vt={transition}
/>
