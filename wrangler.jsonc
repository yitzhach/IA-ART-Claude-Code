// Cloudflare Workers deploy config. `npm run build` first, then `npx wrangler deploy`.
// The name below deploys to a NEW preview Worker (isaacandersonart-v2.<account>.workers.dev),
// so the live site is untouched until the custom domain is moved — see README › Deploying.
{
  "name": "isaacandersonart-v2",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Pages and images are served straight from the cache; code runs only for the assistant API.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ASSISTANT_MODEL": "claude-opus-5-5",
    "ASSISTANT_EFFORT": "low"
  },
  // At most ~12 assistant questions per visitor per minute (per Cloudflare location).
  "ratelimits": [{ "name": "ASK_LIMITER", "namespace_id": "4401", "simple": { "limit": 12, "period": 60 } }],
  "observability": { "enabled": true }
}
